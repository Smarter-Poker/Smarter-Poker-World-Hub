# ═══════════════════════════════════════════════════════════════
# .vercelignore — Exclude non-deployment files from Vercel upload
# ═══════════════════════════════════════════════════════════════
# HARD LAW: Vercel fails at 15,000 files. Keep under 12,000.
# The 11k+ bulk files are in SCRAPE subdirs — exclude only those.
# DO NOT exclude /data/ root or /services/ — API routes import them.
# ═══════════════════════════════════════════════════════════════

# ── Python virtual environment (14k files) ────────────────────
.venv/

# ── Vercel / Next.js build cache (auto-generated) ─────────────
.vercel/
.next/

# ── Node (never committed but just in case) ───────────────────
node_modules/
.git/

# ── DATA SCRAPING OUTPUT (11k+ files — scraper logs only) ─────
# These subdirs contain scraper logs/evidence NOT imported by code
data/scrape-output/
data/scrape-evidence/
data/scrape-evidence-v2/
data/PURGED_AI_GENERATED/
data/bravo-logs/
data/charity-scraper-logs/
data/tournament-logs/
data/pokeratlas-logs/

# ── Agent / tooling dirs ──────────────────────────────────────
.agent/
.agents/
.gemini/
.claude/
.claude-flow/
.hive-mind/
.swarm/
.bg-shell/
.vscode/

# ── Planning and memory (agent-only) ─────────────────────────
.planning/
.memory/
.ocr/

# ── Database migrations (executed separately via Supabase) ────
# The marketplace build contract reads a handful of migrations as deployment
# evidence. Keep only those inputs; the migration tree remains excluded
# otherwise.
#
# THIS ALLOWLIST IS PART OF THE BUILD (2026-08-30). It is not a tidiness
# setting: every file NOT named here is absent from the Vercel upload, so a
# test that reads one fails with ENOENT on the build machine while passing
# perfectly on every developer's laptop, where the whole tree exists. That is
# the least obvious failure mode in this repo.
#
# It took down PRODUCTION DEPLOYS FOR THE WHOLE PLATFORM for ~30 minutes
# today. `__tests__/diamond-store-phase-15.test.mjs` grew two new migration
# reads; both files were committed, both were applied to Supabase, and
# neither was added here. Three consecutive production builds went to ERROR:
#
#   Error: ENOENT: no such file or directory, open
#     '/vercel/path0/supabase/migrations/20260830100000_card_commerce_settlement_hardening.sql'
#
# Nothing after that could publish - not the marketplace change that caused
# it, not the Club Arena bundle behind it, not anything.
#
# SO: if you add a migration read to a build-time test, ADD THE FILE HERE IN
# THE SAME COMMIT. The test passing locally proves nothing about the build.
/supabase/*
!/supabase/migrations/
/supabase/migrations/*
!/supabase/migrations/20260828010000_neural_steel_catalog_expansion.sql
!/supabase/migrations/20260829120000_reserve_merch_order_dry_run.sql
!/supabase/migrations/20260830040000_atomic_diamond_merch_orders.sql
!/supabase/migrations/20260830100000_card_commerce_settlement_hardening.sql
!/supabase/migrations/20260830130000_commerce_refund_replay_guards.sql
/database/
/migrations/
/sql/

# ── Legacy directories ────────────────────────────────────────
_legacy_backups/
_legacy_club_arena_standalone_pages/
_legacy_scripts/
_legacy_logs/
_legacy_sql/

# ── Test / QA ─────────────────────────────────────────────────
/tests/
/e2e/*
!/e2e/05-diamond-store.spec.ts
# The Vercel build runs the compact marketplace contract suite. Keep those
# exact files in the upload while excluding the rest of the large test tree.
/__tests__/*
!/__tests__/diamond-store-phase-7.test.mjs
!/__tests__/diamond-store-phase-8.test.mjs
!/__tests__/diamond-store-phase-9.test.mjs
!/__tests__/diamond-store-phase-10.test.mjs
!/__tests__/diamond-store-phase-11.test.mjs
!/__tests__/diamond-store-phase-12.test.mjs
!/__tests__/diamond-store-phase-13.test.mjs
!/__tests__/diamond-store-phase-14.test.mjs
!/__tests__/diamond-store-phase-15.test.mjs
!/__tests__/printful-fulfillment.test.mjs
!/__tests__/merch-catalog-admin.test.mjs
!/__tests__/marketplace-operations.test.mjs
/playwright/
/playwright-report/
/test-results/

# ── Temporary / output / logs ─────────────────────────────────
/tmp/
/output/
/logs/

# ── Documentation ─────────────────────────────────────────────
/docs/

# ── Heavy asset directories not needed by Next.js runtime ─────
/pokerbrain-assets/

# ── Misc tooling ──────────────────────────────────────────────
/eslint-plugin-smarter-poker/
