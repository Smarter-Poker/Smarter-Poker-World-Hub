# ═══════════════════════════════════════════════════════════════
# .vercelignore — Exclude non-deployment files from Vercel upload
# ═══════════════════════════════════════════════════════════════
# HARD LAW: Vercel fails at 15,000 files. Keep deployable count
# under 12,000. `data/` alone has 11,553 files — MUST be excluded.
# Run: find . -not -path './.git/*' -not -path './node_modules/*' \
#   -type f | wc -l    to measure before adding bulk files.
# ═══════════════════════════════════════════════════════════════

# ── Python virtual environment ────────────────────────────────
.venv/

# ── Node (never committed but just in case) ───────────────────
node_modules/
.git/

# NOTE: Root data/*.json files ARE needed by API routes at build time.
# Only exclude the massive scraping subdirectories (11,319 files total).
/data/scrape-evidence/
/data/scrape-evidence-v2/
/data/scrape-output/
/data/bravo-logs/
/data/charity-scraper-logs/
/data/tournament-logs/
/data/pokeratlas-logs/
/data/PURGED_AI_GENERATED/
/data/charts/
/data/scenarios/

# ── Build / deploy / agent scripts ───────────────────────────
/scripts/
.agent/
.agents/
.gemini/
.claude/
.claude-flow/
.hive-mind/
.swarm/
.bg-shell/
.vscode/

# ── Planning and memory (agent-only) ─────────────────────────
.planning/
.memory/
.ocr/

# ── Database migrations (executed separately) ─────────────────
/supabase/
/database/
/migrations/
/sql/

# ── Legacy directories ────────────────────────────────────────
_legacy_backups/
_legacy_club_arena_standalone_pages/
_legacy_scripts/
_legacy_logs/
_legacy_sql/

# ── Test / QA ─────────────────────────────────────────────────
/tests/
/e2e/
/__tests__/
/playwright/
/playwright-report/
/test-results/

# ── Temporary / output / logs ─────────────────────────────────
/tmp/
/output/
/logs/

# ── Documentation ─────────────────────────────────────────────
/docs/

# ── Heavy asset directories not needed by Next.js runtime ─────
/pokerbrain-assets/

# ── Misc agent/tooling ────────────────────────────────────────
/skills/
/templates/
/worker/
/eslint-plugin-smarter-poker/
