# ═══════════════════════════════════════════════════════════════
# .vercelignore — Exclude non-deployment files from Vercel upload
# ═══════════════════════════════════════════════════════════════
# HARD LAW: Vercel fails at ~15,000 files. Keep deployable count
# under 12,000. Run `git ls-files | wc -l` before bulk additions.
# Current tracked: ~7,200 | Vercel-deployable: ~6,400
# ═══════════════════════════════════════════════════════════════

# Python virtual environment (scraping tools)
.venv

# Build/deploy scripts (not needed at runtime)
scripts/

# Agent configuration and workflows
.agent/
.gemini/
.claude/
.claude-flow/

# Planning and memory (agent-only)
.planning/
.memory/
.ocr/

# Legacy directories (not used in production)
_legacy_backups/
_legacy_club_arena_standalone_pages/
_legacy_scripts/

# Test files
tests/
e2e/

# Temporary files
tmp/

# Documentation (not served)
docs/

# Database migrations (executed separately via npm run db:push)
supabase/
database/
migrations/

# Prevent Vercel from tracking heavy folders
playwright-report/
test-results/
pokerbrain-assets/
node_modules/
.git/
tmp/
output/
scripts/
