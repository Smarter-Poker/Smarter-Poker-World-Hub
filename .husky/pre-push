#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════════
# SMARTER.POKER PRE-PUSH SAFETY GATE
# ═══════════════════════════════════════════════════════════════════════════════
# Prevents pushing code that will fail the Build Safety Gate CI.
# Runs 5 critical checks on the COMMITTED state (not working directory).
# To bypass in emergencies: git push --no-verify
# ═══════════════════════════════════════════════════════════════════════════════

echo ""
echo "═══════════════════════════════════════════════════════"
echo "  SMARTER.POKER PRE-PUSH SAFETY GATE"
echo "═══════════════════════════════════════════════════════"
echo ""

# ─── Test the COMMITTED state, not the working directory ────────────────────
STASH_NAME="pre-push-gate-$(date +%s)"
HAS_CHANGES=false

if ! git diff --quiet HEAD 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
  HAS_CHANGES=true
  echo "Stashing uncommitted changes to test committed state..."
  git stash push -u -m "$STASH_NAME" --quiet 2>/dev/null
fi

# Track changed files for focused scanning
CHANGED_FILES=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || echo "")
echo "Checking $(echo "$CHANGED_FILES" | wc -l | tr -d ' ') changed file(s)..."
echo ""

ERRORS=0

# ─── CHECK 1: Unused hook imports ───────────────────────────────────────────
echo "CHECK 1: Unused hook imports..."
for file in $(echo "$CHANGED_FILES" | grep -v 'public/hub/club-arena/assets/' | grep -E '\.(js|jsx|tsx)$' || true); do
  if [ -f "$file" ]; then
    HOOKS=$(grep -oE 'import\s+\{[^}]*\}' "$file" 2>/dev/null | grep -oE 'use[A-Z][a-zA-Z]+' | sort -u)
    for hook in $HOOKS; do
      CALL_COUNT=$(grep -cE "${hook}\s*[<(]" "$file" 2>/dev/null || echo 0)
      if [ "$CALL_COUNT" -eq 0 ]; then
        echo "  ❌ $file: Hook '$hook' imported but NEVER CALLED"
        ERRORS=$((ERRORS + 1))
      fi
    done
  fi
done
if [ $ERRORS -eq 0 ]; then echo "  ✓ No unused hooks"; fi

# ─── CHECK 2: No .single() calls ───────────────────────────────────────────
echo "CHECK 2: No .single() in Supabase queries..."
# [PP1 FIX] Per-line check so a file with BOTH maybeSingle and .single() isn't falsely cleared.
# Scoped to JS/JSX/TS/TSX only — shell scripts (like this hook) contain the pattern as text.
SINGLES=$(echo "$CHANGED_FILES" | grep -v 'public/hub/club-arena/assets/' | grep -E '\.(js|jsx|ts|tsx)$' | while IFS= read -r file; do
  [ -f "$file" ] || continue
  grep -n '\.single()' "$file" 2>/dev/null | while IFS= read -r hit; do
    # Only flag if this specific line does NOT have maybeSingle on it
    echo "$hit" | grep -q 'maybeSingle' || echo "$file:$(echo "$hit" | cut -d: -f1)"
  done
done || true)
if [ -n "$SINGLES" ]; then
  echo "  ❌ Found .single() calls (must use .maybeSingle()):"
  echo "$SINGLES" | sed 's/^/    /'
  ERRORS=$((ERRORS + 1))
else
  echo "  ✓ No .single() calls"
fi

# ─── CHECK 3: No raw Supabase imports in API routes ────────────────────────
echo "CHECK 3: No raw Supabase imports..."
# [PP2 FIX] Added static import pattern — previous version only caught dynamic `await import` calls.
# Static `import { createClient } from '@supabase/supabase-js'` in API routes was not caught.
RAW_IMPORTS=$(
  { echo "$CHANGED_FILES" | grep 'pages/api/' | xargs grep -ln "await import.*@supabase/supabase-js" 2>/dev/null || true; \
    echo "$CHANGED_FILES" | grep 'pages/api/' | xargs grep -ln "from '@supabase/supabase-js'" 2>/dev/null | xargs grep -L 'supabaseServerClient\|supabaseAdmin' 2>/dev/null || true; } | sort -u
)
if [ -n "$RAW_IMPORTS" ]; then
  echo "  BLOCKED: Found raw @supabase/supabase-js imports:"
  echo "$RAW_IMPORTS" | sed 's/^/    /'
  ERRORS=$((ERRORS + 1))
else
  echo "  ✓ No raw Supabase imports"
fi

# ─── CHECK 4: No merge conflict markers ─────────────────────────────────────
# NOTE: match ANYWHERE on a line — stash pop can produce markers indented
# inside comments/code, not just at column 0. Previous ^ anchored patterns
# missed markers like ` * <<<<<<< Updated upstream` in JSDoc blocks.
echo "CHECK 4: No merge conflict markers..."
CONFLICT_FILES=$(git ls-files '*.js' '*.jsx' '*.ts' '*.tsx' '*.css' | grep -v 'deploy-autofix.js' | xargs grep -ln '<<<<<<< \|>>>>>>>' 2>/dev/null | grep -v 'node_modules' | grep -v 'public/hub/club-arena/assets/' || true)
if [ -n "$CONFLICT_FILES" ]; then
  echo "  BLOCKED: Merge conflict markers found in committed files:"
  echo "$CONFLICT_FILES" | sed 's/^/    /'
  echo ""
  echo "  These WILL break the Vercel build. Resolve all conflict markers before pushing."
  ERRORS=$((ERRORS + 1))
else
  echo "  ✓ No merge conflict markers"
fi

# ─── CHECK 5: Dirty working tree warning ────────────────────────────────────
echo "CHECK 5: Clean working tree..."
DIRTY_FILES=$(git status --porcelain 2>/dev/null | grep -v '^??' | grep -v '^\s*M .memory/' | head -10)
if [ -n "$DIRTY_FILES" ]; then
  echo "  WARNING: Uncommitted changes detected (not blocking, but review):"
  echo "$DIRTY_FILES" | head -5 | sed 's/^/    /'
  DIRTY_COUNT=$(echo "$DIRTY_FILES" | wc -l | tr -d ' ')
  if [ "$DIRTY_COUNT" -gt 5 ]; then
    echo "    ... and $((DIRTY_COUNT - 5)) more"
  fi
else
  echo "  ✓ Working tree clean"
fi

# ─── CHECK 6: Club Arena orphaned assets ────────────────────────────────────
# Detects when someone rebuilt Club Arena but didn't commit the results.
# This prevents the "242 phantom pending changes" problem.
echo "CHECK 6: Club Arena asset integrity..."
ARENA_DIR="public/hub/club-arena"
ARENA_UNTRACKED=$(git ls-files --others --exclude-standard "$ARENA_DIR/" 2>/dev/null | wc -l | tr -d ' ')
ARENA_MODIFIED=$(git diff --name-only "$ARENA_DIR/" 2>/dev/null | wc -l | tr -d ' ')
ARENA_ORPHANS=$((ARENA_UNTRACKED + ARENA_MODIFIED))
if [ "$ARENA_ORPHANS" -gt 0 ]; then
  echo "  ❌ BLOCKED: $ARENA_ORPHANS unstaged Club Arena files detected!"
  echo "     $ARENA_UNTRACKED untracked, $ARENA_MODIFIED modified"
  echo ""
  echo "     Club Arena was rebuilt but changes were NOT committed."
  echo "     Run: bash scripts/build-club-arena.sh \"your commit message\""
  echo "     That script handles the full build → clean → commit → push cycle."
  echo ""
  ERRORS=$((ERRORS + 1))
else
  echo "  ✓ No orphaned Club Arena assets"
fi

# ─── CHECK 6: Club Arena throwables freshness (stale-bundle gate) ───────────
# 2026-08-21: a rebuild from a stale local checkout replaced the current
# Club Arena bundle with a months-old one, silently reverting the throwables
# system in production. Every other gate passed — the bundle was valid, in
# budget, lint-clean. Only its CONTENT was old. This runs whenever the built
# output is part of the push.
echo "CHECK 6: Club Arena throwables freshness..."
if echo "$CHANGED_FILES" | grep -q '^public/hub/club-arena/'; then
  if node scripts/ci/check-ca-throwables-freshness.mjs; then
    echo "  ✓ Club Arena bundle is current"
  else
    echo "  ❌ BLOCKED: the Club Arena bundle being pushed is STALE"
    echo "     Run 'git pull' in ~/Documents/club-arena and rebuild,"
    echo "     or let build-for-world-hub sync from canonical main."
    ERRORS=$((ERRORS + 1))
  fi
else
  echo "  ✓ No Club Arena build output in this push"
fi

# ─── RESTORE ────────────────────────────────────────────────────────────────
if [ "$HAS_CHANGES" = true ]; then
  git stash pop --quiet 2>/dev/null
fi

echo ""
if [ $ERRORS -gt 0 ]; then
  echo "BLOCKED: $ERRORS check(s) FAILED — push BLOCKED"
  echo "   Fix the errors above before pushing."
  echo "   To bypass: git push --no-verify"
  echo ""
  exit 1
fi

echo "✅ All checks passed — push allowed"
echo ""
exit 0
