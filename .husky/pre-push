#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# WORLD HUB PRE-PUSH — the union, and it runs both halves INDEPENDENTLY.
#
# The version this replaces exited 0 early with "No JS/TS files changed. Push
# allowed." A push carrying only public/hub/club-arena/** has no JS/TS files by
# that filter — so the Club Arena bundle checks were skipped by exactly the
# pushes they exist to inspect. Running the two gates as separate scripts makes
# that structurally impossible rather than a comment asking someone to be
# careful.
# ─────────────────────────────────────────────────────────────────────────────
ROOT=$(git rev-parse --show-toplevel)
FAIL=0

sh "$ROOT/scripts/hooks/pre-push-js-safety.sh"   "$@" || FAIL=1

# Dan, 2026-08-31: "REMOVE ANY AND ALL M BARS AS THEY ARE BANNED FROM USE."
# Club Arena has had this gate since 2026-08-27; the apex site never did, so
# every page it serves was unchecked. Comments are stripped before scanning, so
# this only ever speaks about text a person can actually read.
node "$ROOT/scripts/ci/check-ui-text.mjs" || FAIL=1

# The other half of the same instruction, and until now the asymmetric half.
# check-title-case has run in CI since it landed, but not here - so the em dash
# rule was answered before a push and the capitalization rule only after one.
# Both gates are cheap and both read the same files; there is no reason for a
# developer to learn about one of them a minute later than the other.
node "$ROOT/scripts/ci/check-title-case.mjs" || FAIL=1

exit $FAIL
