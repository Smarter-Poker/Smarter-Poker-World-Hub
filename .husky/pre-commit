#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# WORLD HUB PRE-COMMIT — now TRACKED, and therefore now actually runs.
#
# Until this commit, git in this repo used .git/hooks/, because package.json's
# `prepare` ran `git config --unset core.hooksPath`. Those hooks are untracked,
# so twelve checks written from real production incidents protected exactly one
# machine and died on every fresh clone. Meanwhile the tracked .husky copies
# had drifted in BOTH directions and ran nowhere.
#
# This file is the union, and `prepare` now points git at it:
#   scripts/guard-shared-clone.sh    one working tree per agent (rule 1a)
#   scripts/hooks/pre-commit-core.sh the checks that were really running
#   the transpilePackages guard      was tracked-only, so it never ran
#
# Nothing was dropped. Everything that ran on this Mac an hour ago still runs,
# now everywhere.
# ─────────────────────────────────────────────────────────────────────────────
ROOT=$(git rev-parse --show-toplevel)
FAIL=0

sh "$ROOT/scripts/guard-shared-clone.sh"    || FAIL=1

# A commit Vercel cannot attribute never builds. CHECK 15 in ci.yml already
# catches this, but only AFTER the commit is on main and the deployment has
# already gone to BLOCKED. This is the same rule, at the only moment where
# the answer is still "that commit was never made".
sh "$ROOT/scripts/guard-commit-identity.sh" || FAIL=1
sh "$ROOT/scripts/hooks/pre-commit-core.sh" || FAIL=1
sh "$ROOT/scripts/hooks/pre-commit-transpile.sh" || FAIL=1

exit $FAIL
