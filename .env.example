# Smarter.Poker Environment Configuration
# Copy this file to .env.local and fill in the values

# ═══════════════════════════════════════
# Core Services (Required)
# ═══════════════════════════════════════

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development

# Admin API Token (protects admin endpoints in production)
ADMIN_API_TOKEN=your-admin-api-token

# ═══════════════════════════════════════
# Error Monitoring (Sentry) - FREE tier
# Setup: https://sentry.io → Create Next.js project
# ═══════════════════════════════════════
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ═══════════════════════════════════════
# Push Notifications (OneSignal) - FREE tier
# Setup: https://onesignal.com → Create Web Push app
# ═══════════════════════════════════════
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# ═══════════════════════════════════════
# SMS Notifications (Twilio)
# Setup: https://www.twilio.com → Buy phone number
# ═══════════════════════════════════════
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ═══════════════════════════════════════
# Transactional Email (Resend) - FREE tier (100/day)
# Setup: https://resend.com → Get API key
# ═══════════════════════════════════════
RESEND_API_KEY=your-resend-api-key

# ═══════════════════════════════════════
# Google Maps (Home Game Locations)
# Setup: https://console.cloud.google.com → Maps JS API
# ═══════════════════════════════════════
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# ═══════════════════════════════════════
# Payments (Stripe) - Optional
# Setup: https://stripe.com → Get API keys
# ═══════════════════════════════════════
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# ═══════════════════════════════════════
# Live Streaming (LiveKit) - Optional
# Setup: https://livekit.io → Create project
# ═══════════════════════════════════════
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-url

# ═══════════════════════════════════════
# Internal Security Tokens
# ═══════════════════════════════════════
CRON_SECRET=your-cron-secret
ADMIN_SECRET=your-admin-secret
CLEANUP_SECRET=your-cleanup-secret

# ═══════════════════════════════════════
# Email Configuration
# ═══════════════════════════════════════
RESEND_FROM_EMAIL=noreply@smarter.poker
SALES_EMAIL=sales@smarter.poker
