# Smarter.Poker World Hub — Environment Variables
# Copy this file to .env.local and fill in the values
# Last audited: 2026-05-03 (keys rotated; these are PLACEHOLDER values only)
#
# ⚠️  TEMPLATE NOTE (2026-05-03): The SUPABASE_ANON_KEY values in this file are
# intentional placeholders and will return HTTP 401 against live Supabase.
# Get real values from Vercel Dashboard → Settings → Environment Variables,
# or ask a project admin. Do NOT copy-paste keys from this file into prod scripts.

# ═══════════════════════════════════════════════════════════════
# CORE SERVICES (REQUIRED)
# ═══════════════════════════════════════════════════════════════

# Supabase Configuration
# ⚠️ CRITICAL: NEXT_PUBLIC_SUPABASE_URL must appear EXACTLY ONCE in this file.
# Do NOT include a dummy URL to block DNS resolution, as it will override the real URL
# (due to dotenv last-value-wins) and freeze backend daemons that require API access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# App Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════
# SECURITY SECRETS (REQUIRED FOR PRODUCTION)
# Generate strong random secrets for each: openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════

# Protects /api/admin/*, /api/debug/*, /api/emergency/*, destructive poker routes
ADMIN_ROUTE_SECRET=generate-a-strong-secret

# Protects admin API endpoints
ADMIN_API_TOKEN=generate-a-strong-secret

# Protects initial setup endpoints
ADMIN_SETUP_SECRET=generate-a-strong-secret

# Protects cron job endpoints (also used as Bearer token)
CRON_SECRET=generate-a-strong-secret

# Protects cleanup operations
CLEANUP_SECRET=generate-a-strong-secret

# Inter-service authentication for engine API calls
ENGINE_INTERNAL_SECRET=generate-a-strong-secret

# Dedicated HMAC key for sealed Training question receipts. Do not reuse the
# Supabase service-role key; production health fails closed when this is absent.
TRAINING_GRADING_RECEIPT_SECRET=

# Server-side only: distinct 32-byte lowercase-hex HMAC keys for the scoped
# M1/M2 solver gateway. Generate each independently (`openssl rand -hex 32`).
# Never prefix these with NEXT_PUBLIC, reuse one value, commit a value, or put
# the Supabase service-role key on a solver host. The gateway returns 503 while
# the selected worker key is absent/invalid and refuses shared M1/M2 keys.
SOLVER_WORKER_M1_HMAC_SECRET=
SOLVER_WORKER_M2_HMAC_SECRET=

# Venue scraper authentication
VENUE_SCRAPER_SECRET=generate-a-strong-secret

# Hendon Mob auto-sync authentication
HENDON_AUTO_SYNC_SECRET=generate-a-strong-secret

# ═══════════════════════════════════════════════════════════════
# ERROR MONITORING (Sentry) — FREE tier
# Setup: https://sentry.io → Create Next.js project
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_DSN=https://...@sentry.io/...
SENTRY_TOKEN=your-sentry-auth-token

# ═══════════════════════════════════════════════════════════════
# PUSH NOTIFICATIONS (OneSignal) — FREE tier
# Setup: https://onesignal.com → Create Web Push app
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=web.onesignal...
ONESIGNAL_API_KEY=your-api-key
ONESIGNAL_REST_API_KEY=your-rest-api-key
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_GEOFENCE_CHANNEL_ID=your-channel-id

# ═══════════════════════════════════════════════════════════════
# PAYMENTS (Stripe)
# Setup: https://stripe.com → Get API keys
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# RevenueCat webhook (Club Arena iOS/Android app billing, 2026-09-08). The
# value typed into RevenueCat > Project > Integrations > Webhooks >
# Authorization header. Any string of 16+ characters; unset = webhook refuses
# (503), never "accept everything". Dan sets it in Vercel (10.84).
REVENUECAT_WEBHOOK_AUTH=
# Club Arena app links (src/lib/app-links.js). Apple Team ID (10 chars) and the
# SHA-256 fingerprint(s) of the Android RELEASE signing certificate, comma
# separated. Unset = /.well-known/apple-app-site-association and
# /.well-known/assetlinks.json are 404 and the app opens no links. Dan's.
APPLE_TEAM_ID=
ANDROID_RELEASE_CERT_SHA256=
NEXT_PUBLIC_STRIPE_VIP_PRICE_ID=price_...
STRIPE_CHARITY_PRICE_ID=price_...
STRIPE_CLUB_PRICE_ID=price_...
STRIPE_HOME_GAME_PRICE_ID=price_...

# ═══════════════════════════════════════════════════════════════
# GOOGLE MAPS (Venue/Home Game Locations)
# Setup: https://console.cloud.google.com → Maps JS API
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# ═══════════════════════════════════════════════════════════════
# LIVE STREAMING (LiveKit)
# Setup: https://livekit.io → Create project
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# ═══════════════════════════════════════════════════════════════
# WEBRTC TURN/STUN SERVERS
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_TURN_URL=turn:your-turn-server:443
NEXT_PUBLIC_TURN_USERNAME=your-username
NEXT_PUBLIC_TURN_CREDENTIAL=your-credential
NEXT_PUBLIC_TURN_URL_2=turn:your-backup-turn:443
NEXT_PUBLIC_TURN_USERNAME_2=your-username-2
NEXT_PUBLIC_TURN_CREDENTIAL_2=your-credential-2

# ═══════════════════════════════════════════════════════════════
# SMS (Twilio)
# Setup: https://www.twilio.com → Buy phone number
# ═══════════════════════════════════════════════════════════════
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ═══════════════════════════════════════════════════════════════
# EMAIL (Resend) — FREE tier (100/day)
# Setup: https://resend.com → Get API key
# ═══════════════════════════════════════════════════════════════
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@smarter.poker
NEWS_DIGEST_FROM="Smarter.Poker News <news@smarter.poker>"
NEWSLETTER_UNSUBSCRIBE_SECRET=replace-with-a-dedicated-random-secret
SALES_EMAIL=sales@smarter.poker

# Licensed Global Poker Index rankings feed. Regular GPI data use requires a
# licence; never point this at or scrape the public rankings page.
GPI_LICENSED_FEED_URL=https://licensed-feed-provider.example/rankings/poy
GPI_LICENSED_FEED_TOKEN=replace-with-provider-token

# ═══════════════════════════════════════════════════════════════
# AI SERVICES (Grok/xAI ONLY — no OpenAI)
# ═══════════════════════════════════════════════════════════════
XAI_API_KEY=your-xai-key
GROK_API_KEY=your-grok-key
MANUS_API_KEY=your-manus-key
MANUS_API_URL=https://api.manus.ai

# ═══════════════════════════════════════════════════════════════
# THIRD-PARTY APIS
# ═══════════════════════════════════════════════════════════════
GIPHY_API_KEY=your-giphy-api-key
POKERATLAS_VENUE_KEY=your-pokeratlas-key
SOCIAL_HUB_API_KEY=your-social-hub-key
SOCIAL_HUB_API_URL=https://api.social-hub.example
GITHUB_TOKEN=your-github-token

# ═══════════════════════════════════════════════════════════════
# WEBHOOKS
# ═══════════════════════════════════════════════════════════════
HORSE_ALERT_WEBHOOK=https://hooks.slack.com/services/...

# ═══════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_ANTIGRAVITY_ENABLED=false
# Server-only, fail-closed release control for diamond-wagered Trivia PvP.
# Keep false until the server-owned matchmaking endpoint and containment
# migration are deployed. Only the exact value `true` enables the feature.
TRIVIA_PVP_ENABLED=false
# House-funded PvP opponents require a second independent opt-in.
TRIVIA_PVP_HORSES_ENABLED=false
# Server-only, fail-closed controls for diamond-moving Trivia tournaments.
# The tournament switch gates entry, play, settlement/lifecycle mutation, and
# direct page access. Horse population is a separate opt-in and stays disabled
# even when tournaments are enabled unless its own value is exactly `true`.
TRIVIA_TOURNAMENTS_ENABLED=false
TRIVIA_TOURNAMENT_HORSES_ENABLED=false

# ═══════════════════════════════════════════════════════════════
# AUTO-SET BY PLATFORM (DO NOT SET MANUALLY)
# ═══════════════════════════════════════════════════════════════
# NODE_ENV — Set by Next.js
# VERCEL_URL — Set by Vercel
# VERCEL_GIT_COMMIT_SHA — Set by Vercel
# NEXT_PUBLIC_BUILD_ID — Set at build time
# LOG_LEVEL — defaults to 'info'

# ═══════════════════════════════════════════════════════════════
# TEST ACCOUNT (Playwright e2e + browser-testing workflows)
# ═══════════════════════════════════════════════════════════════
# 2026-08-15: this was hardcoded in 42 tracked files in a PUBLIC repo.
# Never inline it again — read it from the environment.
# 2026-09-04: and never a PERSON's account. Dan: 'KEEP MY ACCOUNT CLEAN.' The
# test identity is the platform service account; its address and password
# live in .env.local (never here, never in a script).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════
# AGENT DOCTRINE — the three that have actually destroyed work here
# ═══════════════════════════════════════════════════════════════════════════
# Added 2026-09-06. Nothing below is a secret or read at build time. It is in
# .env.example because that file is TRACKED: the real .env is gitignored, so a
# note left only there exists on exactly one Mac and no fresh clone ever sees
# it. Copy this block into your own .env if you want the override variable.
#
# ── 1. A PUSH TO A BRANCH WHOSE PR ALREADY MERGED SUCCEEDS AND DELIVERS
#       NOTHING ────────────────────────────────────────────────────────────
# agent-autopilot.yml squash-merges the moment the required checks pass, which
# on an asset-only or docs change can be under two minutes. Push again after
# that and the branch moves, the pull request stays merged, `git push` exits 0,
# and your commits reach nobody.
#
# World Hub #1387 shipped 1 of its 3 commits this way on 2026-09-06. The push
# said success. The PR said merged. The branch on GitHub really did contain all
# three. A CI fix for a gate that had been red on main for two days, and the
# deletion of a component that fabricated player data, simply were not there -
# found hours later by accident.
#
# scripts/guard-merged-branch.sh now refuses that push from .husky/pre-push in
# both repos. It fails OPEN on a missing token, no network, or any unclear
# answer, so it can never block you because GitHub is having a bad day.
#
# IF YOU NEED A FOLLOW-UP COMMIT, MAKE A NEW BRANCH OFF CURRENT MAIN.
# Deliberate override, when you really do mean to move a merged branch:
#   AGENT_MERGED_BRANCH_OK=1 git push ...
#
# ── 2. MERGED IS NOT LANDED ────────────────────────────────────────────────
# Verify the FILES are on origin/main, never the pull request's green tick:
#
#   git fetch origin main
#   git cat-file -e origin/main:<path> && echo on-main || echo NOT-ON-MAIN
#
# This is the same rule CLAUDE.md 1.4 already sets for deploys - only
# production serving the sha counts as deployed - and it applies to merges for
# exactly the same reason: every intermediate signal can be true while the
# outcome is false.
#
# ── 3. A GREEN CHECK MAY NOT HAVE RUN ──────────────────────────────────────
# A search that returns nothing because it was killed looks identical to a
# search that found nothing. Both cost 244 MB of nearly-wrong deletions on
# 2026-09-05: two scans returned "0 hits" having been terminated mid-run, and a
# third used `rg`, which is NOT INSTALLED on this Mac and exits quietly. grep
# is.
#
# Put a known-positive control in any scan you are about to act on. If the
# control does not come back, the scan did not run - whatever its exit code
# said. The same rule is why tests/helpers/sourceWindow.ts now anchors in
# blanked source: a pin that matches a COMMENT is a pin that is not reading
# code, and it passes forever while guarding nothing.
#
# ── WHERE THE GUARDS LIVE ──────────────────────────────────────────────────
# So they are not "cleaned up" by someone who does not know what they cost:
#   scripts/guard-merged-branch.sh      refuses a push onto a merged PR
#   scripts/guard-shared-clone.sh       one working tree per agent
#   scripts/prune-stale-worktrees.sh    removes only clean + pushed + idle 72h
#   scripts/ci/check-main-is-green.mjs  (World Hub) nothing silently red on main
#   scripts/ci/check-public-budget.mjs  (World Hub) public/ only ever shrinks
#
# Unpushed agent work is BUNDLED, never pushed: pushing a stale branch opens a
# pull request and arms auto-merge on work nobody reviewed. Bundles live in
# ~/Documents/agent-branch-backups/ and each carries a MANIFEST.md.

# ═══════════════════════════════════════════════════════════════
# Firebase Cloud Messaging (Club Arena iOS/Android app push, 2026-09-08)
# The Firebase service-account JSON (Project settings > Service accounts >
# Generate new private key), as one line or base64. Dan sets it in Vercel
# (10.84). Unset = native tokens report fcm_not_configured and are not retired.
# ═══════════════════════════════════════════════════════════════
FCM_SERVICE_ACCOUNT_JSON=
