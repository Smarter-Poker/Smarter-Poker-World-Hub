{
  "name": "hub-vanguard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx kill-port 3000 2>/dev/null; NODE_OPTIONS='--max-old-space-size=16384' next dev -p 3000",
    "clean:dev": "npx kill-port 3000 && rm -rf .next node_modules/.cache && NODE_OPTIONS='--max-old-space-size=16384' next dev -p 3000",
    "nuke:dev": "npx kill-port 3000 && rm -rf .next node_modules/.cache && NODE_OPTIONS='--max-old-space-size=16384' next dev -p 3000",
    "dev:watch": "bash scripts/dev-watchdog.sh",
    "build": "NODE_OPTIONS='--max-old-space-size=7168' next build",
    "start": "next start",
    "ingest:us-events": "npx ts-node --esm src/ingest_us_events/run.ts",
    "warm-geeves": "node scripts/warmGeevesCache.js",
    "db:push": "node scripts/antigravity_sql_push.js",
    "db:status": "node scripts/antigravity_sql_push.js --status supabase/migrations/",
    "deploy": "bash scripts/antigravity-deploy.sh",
    "deploy:log": "node scripts/deploy-log.js --show",
    "push": "bash scripts/git-safe-push.sh",
    "verify": "node scripts/verify-deploy.js",
    "postinstall": "bash scripts/install-hooks.sh 2>/dev/null || true",
    "lint": "next lint",
    "prepare": "husky"
  },
