{
  "name": "hub-vanguard",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "postinstall": "git config --unset core.hooksPath 2>/dev/null; bash scripts/install-hooks.sh 2>/dev/null || true",
    "predev": "bash scripts/heal.sh --quick 2>/dev/null || true",
    "dev": "npx kill-port 3000 2>/dev/null; NODE_OPTIONS='--max-old-space-size=16384' node node_modules/next/dist/bin/next dev --webpack -p 3000",
    "heal": "bash scripts/heal.sh",
    "heal:quick": "bash scripts/heal.sh --quick",
    "clean:dev": "npx kill-port 3000 && rm -rf .next node_modules/.cache && NODE_OPTIONS='--max-old-space-size=16384' node node_modules/next/dist/bin/next dev -p 3000",
    "nuke:dev": "npx kill-port 3000 && rm -rf .next node_modules/.cache && NODE_OPTIONS='--max-old-space-size=16384' node node_modules/next/dist/bin/next dev -p 3000",
    "dev:watch": "bash scripts/dev-watchdog.sh",
    "gen:equity-worker": "node scripts/gen-equity-worker.js",
    "prebuild": "node scripts/gen-equity-worker.js --check && node --test __tests__/auth-routes-exist.test.mjs __tests__/menu-routes-exist.test.mjs __tests__/pa-no-undef.test.mjs __tests__/equity-worker-parity.test.mjs __tests__/leak-review-scheduler.test.mjs",
    "build": "node scripts/patch-next.js && NODE_OPTIONS='--max-old-space-size=7168' node node_modules/next/dist/bin/next build",
    "test:auth-guard": "node --test __tests__/auth-routes-exist.test.mjs",
    "start": "node node_modules/next/dist/bin/next start",
    "ingest:us-events": "npx ts-node --esm src/ingest_us_events/run.ts",
    "warm-geeves": "node scripts/warmGeevesCache.js",
    "db:push": "node scripts/antigravity_sql_push.js",
    "db:status": "node scripts/antigravity_sql_push.js --status supabase/migrations/",
    "deploy": "bash scripts/antigravity-deploy.sh",
    "deploy:log": "node scripts/deploy-log.js --show",
    "deploy:status": "node scripts/check-deploy-status.js",
    "deploy:watch": "node scripts/check-deploy-status.js --watch",
    "deploy:force": "bash scripts/force-redeploy.sh",
    "push": "bash scripts/git-safe-push.sh",
    "verify": "node scripts/verify-deploy.js",
    "lint": "node node_modules/next/dist/bin/next lint",
    "prepare": "git config --unset core.hooksPath 2>/dev/null || true"
  },
