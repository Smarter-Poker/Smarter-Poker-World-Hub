          "notes": "WPT Prime (lower buy-in) series schedule."
        },
        "stop_schedules": {
          "url": "https://www.worldpokertour.com/tournaments/",
          "method": "puppeteer",
          "notes": "Stop-level schedule pages for individual WPT events."
        },
        "pokeratlas": {
          "url": "https://www.pokeratlas.com/poker-tournaments/wpt",
          "method": "scrapling",
          "notes": "PokerAtlas WPT schedule aggregation."
        },
        "hendonmob": {
          "url": "https://www.thehendonmob.com/festivals/world-poker-tour",
          "method": "scrapling",
          "notes": "Hendon Mob WPT data."
        }
      },
      "schedule_release": "Rolling (announced per-stop)",
      "series_window": "Year-round"
    },
