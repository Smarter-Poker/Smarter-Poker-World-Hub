{
  "metadata": {
    "description": "SOURCE OF TRUTH: Authoritative scraping URLs for all US traveling poker tour schedules. Used by automated scrapers to refresh tour-source-registry.json.",
    "created": "2026-04-04",
    "last_updated": "2026-04-08",
    "refresh_interval_days": 3,
    "pdf_scraping_enabled": true,
    "notes": "These URLs are the CANONICAL sources for schedule data. Each tour has primary (official site), secondary (aggregator), PDF schedule downloads, and API sources where available. PDF sources provide event-level detail (event#, time, buy-in, GTD, chips, levels)."
  },
  "tours": {
    "WSOP": {
      "tour_name": "World Series of Poker",
      "scrape_priority": 1,
      "sources": {
        "primary": {
          "url": "https://www.wsop.com/tournaments/",
          "method": "puppeteer",
          "notes": "Official WSOP schedule page. JS-rendered, requires headless browser."
        },
        "pokernews_schedule": {
          "url": "https://www.pokernews.com/tours/wsop/2026-wsop/schedule.htm",
          "method": "puppeteer",
          "notes": "PokerNews WSOP schedule page with detailed event breakdowns. JS-rendered table."
        },
        "pokernews_pdf": {
          "url": "https://content.pokernews.com/2026-wsop-schedule.pdf",
          "method": "pdf_direct",
          "notes": "Printable PDF of full WSOP schedule — most reliable static source with all 100 events."
        },
        "wsop_official_pdf": {
          "url": "https://www.wsop.com/2026/assets/2026-WSOP-Official-Schedule.pdf",
          "method": "pdf_direct",
          "notes": "Verified official WSOP 2026 schedule PDF."
        },
        "pokeratlas": {
          "url": "https://www.pokeratlas.com/poker-tournaments/wsop",
          "method": "scrapling",
          "notes": "PokerAtlas aggregator with structured tournament data."
        },
        "hendonmob": {
          "url": "https://www.thehendonmob.com/festivals/world-series-of-poker",
          "method": "scrapling",
          "notes": "Hendon Mob festival data with results integration."
        }
      },
      "selectors": {
        "event_list": "table tbody tr, .event-row, .schedule-item",
        "event_name": ".event-name, td:nth-child(2), .title",
        "buy_in": ".buy-in, td:nth-child(3), .buyin",
        "start_date": ".start-date, td:nth-child(4), .date",
        "guaranteed": ".guarantee, .gtd"
      },
      "schedule_release": "February (annually)",
      "series_window": "Late May - Mid July"
    },
    "WPT": {
      "tour_name": "World Poker Tour",
      "scrape_priority": 1,
      "sources": {
        "primary": {
          "url": "https://www.worldpokertour.com/schedule/",
          "method": "puppeteer",
          "notes": "Official WPT schedule. React SPA, requires JS rendering."
        },
        "wpt_prime": {
          "url": "https://www.worldpokertour.com/wpt-prime/",
