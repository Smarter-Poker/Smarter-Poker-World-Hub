{
  "openapi": "3.1.0",
  "info": {
    "title": "Smarter.Poker Public AI Agent API",
    "description": "Public, machine-readable API for autonomous AI agents, LLMs, and poker players to query verified poker venues, live rooms, tournament series, and schedules nationwide.",
    "version": "1.0.0",
    "contact": {
      "name": "Smarter Software Inc.",
      "url": "https://smarter.poker",
      "email": "support@smarter.poker"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://smarter.poker/terms"
    }
  },
  "servers": [
    {
      "url": "https://smarter.poker",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/api/ai/venues": {
      "get": {
        "operationId": "searchVenues",
        "summary": "Search Poker Venues and Card Rooms",
        "description": "Returns verified poker venues filtered by state, city, name, or keyword query.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Search term matching venue name, city, address, or brand.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "Two-letter US state code (e.g., NV, CA, TX, FL).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "City name filter.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results to return (default 20, max 100).",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching poker venues with location and contact metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenueSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/venues/{id}": {
      "get": {
        "operationId": "getVenueDetails",
        "summary": "Get Detailed Poker Venue Information",
        "description": "Retrieves comprehensive information about a single poker venue, including address, phone, amenities, social card image, and canonical URL.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique numeric or string ID of the venue.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed venue profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenueDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Venue not found."
          }
        }
      }
    },
    "/api/ai/series": {
      "get": {
        "operationId": "searchSeries",
        "summary": "Search Poker Tournament Series and Festivals",
        "description": "Returns upcoming, ongoing, and past major poker tournament series across WSOP, WPT, MSPT, RGPS, and independent festivals.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Search term matching tour, series name, or host casino.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "Two-letter US state code.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of series to return (default 20, max 100).",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching poker tournament series.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp": {
      "post": {
        "operationId": "callMcpRpc",
        "summary": "Model Context Protocol JSON-RPC 2.0 Tool Execution",
        "description": "Executes Model Context Protocol (MCP) tool calls including calculate_poker_odds, get_preflop_chart, calculate_icm_payouts, get_poker_term_definition, search_poker_venues, and search_tournament_series.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "example": "2.0"
                  },
                  "id": {
                    "type": "string",
                    "example": "1"
                  },
                  "method": {
                    "type": "string",
                    "example": "tools/call"
                  },
                  "params": {
                    "type": "object"
                  }
                },
                "required": [
                  "jsonrpc",
                  "method"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC 2.0 tool execution result with structured data and web citations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getMcpServerInfo",
        "summary": "MCP Server Capabilities and SSE Transport",
        "description": "Returns active MCP server capabilities or establishes a Server-Sent Events (SSE) connection with ?transport=sse.",
        "responses": {
          "200": {
            "description": "Server metadata or active SSE event stream."
          }
        }
      }
    },
    "/api/ai/odds": {
      "get": {
        "operationId": "calculatePokerOdds",
        "summary": "Calculate Multiway Poker Equity and Odds",
        "description": "Calculates exact and Monte Carlo hand equity, win probabilities, and tie probabilities for Texas Hold'em and Omaha (PLO-4, PLO-5, PLO-6).",
        "parameters": [
          {
            "name": "hands",
            "in": "query",
            "description": "Player hole cards (e.g. AhKd,QcQd).",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AhKd,QcQd"
            }
          },
          {
            "name": "board",
            "in": "query",
            "description": "Community board cards (e.g. JhTs2c).",
            "required": false,
            "schema": {
              "type": "string",
              "example": "JhTs2c"
            }
          },
          {
            "name": "game",
            "in": "query",
            "description": "Poker game variant: nlhe, plo4, plo5, plo6.",
            "required": false,
            "schema": {
              "type": "string",
              "default": "nlhe"
            }
          },
          {
            "name": "iterations",
            "in": "query",
            "description": "Simulation runs (default 5000, max 20000).",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Calculated equity percentages with citation URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OddsCalculationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/preflop": {
      "get": {
        "operationId": "getPreflopRange",
        "summary": "Get GTO Preflop Opening Ranges",
        "description": "Returns solver-calculated 6-Max 100BB GTO opening frequencies for UTG, MP, HJ, CO, BTN, or SB.",
        "parameters": [
          {
            "name": "position",
            "in": "query",
            "description": "Table position: UTG, MP, HJ, CO, BTN, SB.",
            "required": false,
            "schema": {
              "type": "string",
              "default": "UTG",
              "enum": [
                "UTG",
                "MP",
                "HJ",
                "CO",
                "BTN",
                "SB"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GTO opening frequencies and interactive range matrix link.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreflopRangeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/icm": {
      "get": {
        "operationId": "calculateIcmPayouts",
        "summary": "Calculate Tournament ICM Dollar Equity",
        "description": "Computes Malmuth-Harville Independent Chip Model (ICM) tournament equity payouts from player chip stacks.",
        "parameters": [
          {
            "name": "stacks",
            "in": "query",
            "description": "Comma-separated chip counts (e.g. 50000,30000,20000).",
            "required": true,
            "schema": {
              "type": "string",
              "example": "50000,30000,20000"
            }
          },
          {
            "name": "payouts",
            "in": "query",
            "description": "Comma-separated prize payouts (e.g. 5000,3000,2000).",
            "required": true,
            "schema": {
              "type": "string",
              "example": "5000,3000,2000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ICM dollar equity per player with citation URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IcmCalculationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/terms": {
      "get": {
        "operationId": "getPokerTerm",
        "summary": "Lookup Authoritative Poker Terminology",
        "description": "Returns verified poker definitions, GTO acronyms, and live room rules from the official glossary.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Poker term or jargon query (e.g. straddle, pot odds, icm, 3-bet).",
            "required": false,
            "schema": {
              "type": "string",
              "example": "straddle"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching glossary definitions, related terms, and canonical links.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlossaryTermsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/freerolls": {
      "get": {
        "operationId": "getFreerollSchedule",
        "summary": "Retrieve Daily $2,000 Freerolls & Diamond Freerolls Schedule",
        "description": "Provides the upcoming Daily $2,000 Freeroll tournaments schedule, formats, prize values, and entry criteria.",
        "parameters": [
          {
            "name": "tier",
            "in": "query",
            "description": "Filter by tournament tier: all, open, or diamond.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "open",
                "diamond"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daily freeroll schedule, guarantees, tier rules, and registration links.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "daily_guarantee": {
                      "type": "string"
                    },
                    "entry_requirements": {
                      "type": "string"
                    },
                    "schedule": {
                      "type": "array"
                    },
                    "freerolls_hub_url": {
                      "type": "string"
                    },
                    "markdown_url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
