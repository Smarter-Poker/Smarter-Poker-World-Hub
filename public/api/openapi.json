                      "type": "string"
                    },
                    "pricing": {
                      "type": "string"
                    },
                    "tax_compliance_features": {
                      "type": "object"
                    },
                    "bankroll_analytics": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
