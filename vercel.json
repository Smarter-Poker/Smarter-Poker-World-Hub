        {
          "key": "Pragma",
          "value": ""
        }
      ]
    },
    {
      "source": "/hub/:path*/:file.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        },
        {
          "key": "Pragma",
          "value": ""
        }
      ]
    },
    {
      "source": "/hub/:path*/:file.avif",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        },
        {
          "key": "Pragma",
          "value": ""
        }
      ]
    },
    {
      "source": "/hub/:path*/:file.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        },
        {
          "key": "Pragma",
          "value": ""
        }
      ]
    },
    {
      "source": "/hub/:path*/:file.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        },
        {
          "key": "Pragma",
          "value": ""
        }
      ]
    },
    {
      "source": "/hub/:path*/:file.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Pragma",
