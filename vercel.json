{
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": true
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(self), camera=(self), display-capture=(self), payment=(), usb=(), serial=(), bluetooth=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=(), autoplay=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), fullscreen=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), picture-in-picture=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), browsing-topics=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/api/notifications/feed",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, max-age=15, stale-while-revalidate=60"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/user/get-header-stats",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, max-age=30, stale-while-revalidate=120"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/social/feed",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=15, stale-while-revalidate=60"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/social/stories",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=30, stale-while-revalidate=120"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/public/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/poker/daily-tournaments",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=120, stale-while-revalidate=600"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/training/leaderboard",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/arcade/leaderboard",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/hub/:orb*/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hub/:orb*/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/hub/:orb*/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hub/:orb*/cards/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hub/:orb*/sounds/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hub/:orb*/club-logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/hub/((?!.*?/assets/)(?!.*?/images/)(?!.*?/videos/)(?!.*?/cards/)(?!.*?/sounds/)(?!.*?/club-logos/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/hub",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/hub/:path*/:file.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        },
        {
          "key": "Pragma",
          "value": ""
        }
