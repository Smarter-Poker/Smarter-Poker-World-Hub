{
  "framework": "nextjs",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": true
  },
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "buildCommand": "bash scripts/prune-platform-bins.sh && node scripts/patch-next.js && NODE_OPTIONS='--max-old-space-size=7168' next build --webpack",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(self), camera=(self), display-capture=(self), payment=(), usb=(), serial=(), bluetooth=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=(), autoplay=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), fullscreen=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), picture-in-picture=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), browsing-topics=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/api/notifications/feed",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, max-age=15, stale-while-revalidate=60"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/user/get-header-stats",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, max-age=30, stale-while-revalidate=120"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/social/feed",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=15, stale-while-revalidate=60"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/social/stories",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=30, stale-while-revalidate=120"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/public/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/poker/daily-tournaments",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=120, stale-while-revalidate=600"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/training/leaderboard",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/api/arcade/leaderboard",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Pragma",
          "value": ""
        },
        {
          "key": "Expires",
          "value": ""
        }
      ]
    },
    {
      "source": "/hub/:orb*/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hub/:orb*/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/hub/:orb*/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hub/:orb*/cards/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hub/:orb*/sounds/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hub/:orb*/club-logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/hub/((?!.*?/assets/)(?!.*?/images/)(?!.*?/videos/)(?!.*?/cards/)(?!.*?/sounds/)(?!.*?/club-logos/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/hub",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/hub/:path*/:file.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.jpeg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.avif",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.woff",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.ttf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.mp4",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.webm",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Pragma", "value": "" }
      ]
    },
    {
      "source": "/hub/:path*/:file.mp3",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Pragma", "value": "" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/signup-probe", "schedule": "0 2 * * *" },
    { "path": "/api/cron/signup-probe-restricted", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/sentry-signup-bridge", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/trigger-audit", "schedule": "0 6 * * *" },
    { "path": "/api/cron/email-deliverability-check", "schedule": "0 7 * * *" },
    { "path": "/api/cron/archive-signup-errors", "schedule": "0 3 * * *" },
    { "path": "/api/cron/login-probe", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/recovery-probe", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/auth-integrity-audit", "schedule": "0 4 * * *" },
    { "path": "/api/cron/generate-trivia", "schedule": "5 5 * * *" },
    { "path": "/api/cron/trivia-pool-guard", "schedule": "30 13 * * *" },
    { "path": "/api/cron/trivia-tournament-tick", "schedule": "0,15,30,45 * * * *" }
  ],
  "rewrites": [
    {
      "source": "/commander/:path*",
      "destination": "https://commander.smarter.poker/commander/:path*"
    },
    {
      "source": "/api/commander/:path*",
      "destination": "https://commander.smarter.poker/api/:path*"
    }
  ]
}
