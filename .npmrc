# @smarter-poker/commander-shared is VENDORED at vendor/commander-shared and
# installed through a file: dependency. The GitHub Packages registry that used
# to serve it is deliberately no longer on the production build path: Vercel's
# NPM_TOKEN 401'd on 2026-07-27 and blocked three consecutive production
# deploys. See .agent/audits/2026-07-27-vercel-npm-401-commander-shared.md.

# Required: eslint@8 conflicts with eslint-config-next@16 peer dep requirements.
# Without this, `npm install` exits non-zero and leaves node_modules broken or absent.
# This was causing node_modules to silently fail to restore after git-safe-push git clean runs.
legacy-peer-deps=true
