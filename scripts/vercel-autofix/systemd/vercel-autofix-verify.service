[Unit]
Description=Vercel autofix Phase B — post-merge verify + auto-revert
Documentation=https://github.com/Smarter-Poker/Smarter-Poker-World-Hub/blob/main/scripts/vercel-autofix/README.md
After=network-online.target
Wants=network-online.target
# Don't step on the poller — they share the Vercel token quota
After=vercel-autofix-poll.service

[Service]
Type=oneshot
User=autofix
Group=autofix
WorkingDirectory=/opt/vercel-autofix-poller
EnvironmentFile=/opt/vercel-autofix-poller/.env
ExecStart=/usr/bin/node /opt/vercel-autofix-poller/phase-b-verify.mjs

# Hardening — same profile as the poller
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/opt/vercel-autofix-poller/state

# Resource caps — the verify job opens revert PRs so give it a bit more time
MemoryMax=256M
CPUQuota=25%
TimeoutStartSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vercel-autofix-verify

[Install]
WantedBy=multi-user.target
