[Unit]
Description=Vercel build-failure autofix poller
Documentation=https://github.com/Smarter-Poker/Smarter-Poker-World-Hub/blob/main/scripts/vercel-autofix/README.md
After=network-online.target
Wants=network-online.target
# Don't fight with the sentry poller — both tap the same Supabase quota
After=sentry-autofix-poll.service

[Service]
Type=oneshot
User=autofix
Group=autofix
WorkingDirectory=/opt/vercel-autofix-poller
EnvironmentFile=/opt/vercel-autofix-poller/.env
ExecStart=/usr/bin/node /opt/vercel-autofix-poller/poll.mjs

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/opt/vercel-autofix-poller/state

# Resource caps — the poller is tiny, but guard against a runaway fetch loop
MemoryMax=256M
CPUQuota=25%
TimeoutStartSec=90

# Logs go to journald, keyed by this unit name
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vercel-autofix-poll

[Install]
WantedBy=multi-user.target
