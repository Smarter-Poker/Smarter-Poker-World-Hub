# Copy to /opt/vercel-autofix-poller/.env on cron-01 and `chmod 600`
# Owned by the `autofix` user that runs the systemd unit.

# ── Vercel ───────────────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_SVD8r7AOPH065G3usBxVvrBc

# ── GitHub (PAT with `repo` scope on the 3 target repos) ─────────────────
GITHUB_TOKEN=

# ── Supabase (service-role key — this machine must be firewalled) ────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Operational knobs (safe defaults baked in; override sparingly) ───────
# STALE_QUEUED_MINUTES=15
# LOG_TAIL_LINES=400
# LOOKBACK_MINUTES=60
# DRY_RUN=0
