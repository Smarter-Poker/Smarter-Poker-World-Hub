{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Health + cost observability for the Sentry/Vercel autofix pipelines. Reads directly from the Supabase Postgres tables autofix_attempts, autofix_config, autofix_budget.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Kill-switch",
      "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select case when paused then 1 else 0 end as value, coalesce(paused_reason, '—') as reason from autofix_config where id = 1"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^value$/", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "RUNNING", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "PAUSED", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Today's spend ($)",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 4, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(source, 'unknown') as metric, sum( (coalesce(claude_tokens_in,0)::numeric/1e6)*1.00 + (coalesce(claude_tokens_out,0)::numeric/1e6)*5.00 ) as value from autofix_attempts where created_at >= date_trunc('day', now() at time zone 'utc') group by source order by source"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 1.6 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Oldest open PR (hours)",
      "id": 3,
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select extract(epoch from (now() - min(pr_opened_at))) / 3600.0 as value from autofix_attempts where status = 'pr_opened' and merged_at is null and reverted_at is null"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^value$/" },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "yellow", "value": 24 },
              { "color": "red", "value": 72 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Success rate (24h)",
      "id": 4,
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with w as (select * from autofix_attempts where created_at >= now() - interval '24 hours' and status not in ('skipped_paused','skipped_budget','skipped_unfixable')) select case when count(*) = 0 then 0 else 100.0 * count(*) filter (where status in ('pr_opened','merged','build_verified')) / count(*) end as value from w"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^value$/" },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red" },
              { "color": "yellow", "value": 40 },
              { "color": "green", "value": 70 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Attempts / hour by source",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select date_trunc('hour', created_at) as time, coalesce(source, 'unknown') as metric, count(*)::int as value from autofix_attempts where $__timeFilter(created_at) group by 1, 2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal", "group": "A" }
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Daily $ spend by source",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select date_trunc('day', created_at) as time, coalesce(source, 'unknown') as metric, sum( (coalesce(claude_tokens_in,0)::numeric/1e6)*1.00 + (coalesce(claude_tokens_out,0)::numeric/1e6)*5.00 ) as value from autofix_attempts where $__timeFilter(created_at) group by 1, 2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": { "mode": "normal", "group": "A" }
          }
        }
      }
    },
    {
      "type": "piechart",
      "title": "Status distribution (7d)",
      "id": 7,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select status as metric, count(*)::int as value from autofix_attempts where created_at >= now() - interval '7 days' group by status order by value desc"
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "table", "values": ["value", "percent"], "placement": "right" }
      }
    },
    {
      "type": "table",
      "title": "Recent errored / rejected (50)",
      "id": 8,
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 12 },
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select created_at, source, status, repo, left(commit_sha, 7) as sha, pr_number, left(coalesce(error_message,''), 140) as error from autofix_attempts where status in ('errored','rejected') order by created_at desc limit 50"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Budget caps vs spend (today)",
      "id": 9,
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "postgres", "uid": "${DS_SUPABASE}" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with spend as (select coalesce(source,'unknown') as source, sum( (coalesce(claude_tokens_in,0)::numeric/1e6)*1.00 + (coalesce(claude_tokens_out,0)::numeric/1e6)*5.00 ) as spent from autofix_attempts where created_at >= date_trunc('day', now() at time zone 'utc') group by 1) select b.source as metric, least(100, round((coalesce(s.spent,0)/nullif(b.daily_cap_usd,0))*100)) as value from autofix_budget b left join spend s on s.source = b.source order by b.source"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green" },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 95 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["autofix", "sentry", "vercel", "supabase"],
  "templating": {
    "list": [
      {
        "name": "DS_SUPABASE",
        "type": "datasource",
        "label": "Supabase (postgres)",
        "query": "postgres",
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Autofix pipelines — health & cost",
  "uid": "autofix-pipelines",
  "version": 1,
  "weekStart": ""
}
