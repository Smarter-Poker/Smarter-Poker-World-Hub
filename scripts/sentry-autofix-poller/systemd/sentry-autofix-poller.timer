[Unit]
Description=Run Sentry autofix poller every 15 minutes
Requires=sentry-autofix-poller.service

[Timer]
# First run 2 minutes after boot, then every 15 minutes.
OnBootSec=2min
OnUnitActiveSec=15min
# If the system was off when the unit would have run, run on next boot.
Persistent=true
# Add small random jitter so concurrent runs across boxes don't thundering-herd Sentry.
RandomizedDelaySec=30
Unit=sentry-autofix-poller.service

[Install]
WantedBy=timers.target
