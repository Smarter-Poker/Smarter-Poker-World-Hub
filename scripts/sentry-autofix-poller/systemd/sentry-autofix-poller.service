[Unit]
Description=Sentry autofix poller — queries Sentry for new unresolved issues and fires repository_dispatch
Documentation=https://github.com/Smarter-Poker/Smarter-Poker-World-Hub/blob/main/docs/sentry-autofix.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sentry-autofix-poller
EnvironmentFile=/opt/sentry-autofix-poller/.env
ExecStart=/usr/bin/node /opt/sentry-autofix-poller/poll.mjs
StandardOutput=journal
StandardError=journal
# Fail-safe: never hang forever.
TimeoutStartSec=120
# Light hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sentry-autofix-poller
PrivateTmp=true

[Install]
WantedBy=multi-user.target
