.gemini/

# Auto-generated service worker files (next-pwa / workbox)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map

# Deploy audit trail
logs/

# Next.js build artifacts
public/worker-*.js

# Legacy one-off scripts, logs, SQL moved from root
_legacy_scripts/
_legacy_logs/
_legacy_sql/
.venv
!.venv/.gitkeep

# Scraper daemon outputs (data goes to Supabase, these are ephemeral local audit trails)
# Keep directories via .gitkeep — ignore contents only
data/scrape-evidence/*
!data/scrape-evidence/.gitkeep
data/bravo-live-snapshot.json
data/pokeratlas-live-snapshot.json
data/bravo-logs/*
!data/bravo-logs/.gitkeep
data/pokeratlas-logs/*
!data/pokeratlas-logs/.gitkeep

# Charity scraper logs — keep dir, ignore contents
data/charity-scraper-logs/*
!data/charity-scraper-logs/.gitkeep

# Background shell state
.bg-shell/

# Python bytecode
__pycache__/
*.pyc

# Poker Brain dev assets (reference screenshots, debug crops)
pokerbrain-assets/
scripts/poker-brain/.venv/

# Ephemeral daemon state logs — keep dir, ignore contents
data/tournament-logs/*
!data/tournament-logs/.gitkeep

# Club Arena build artifacts — DO NOT gitignore!
# Vercel deploys from git, so these MUST be committed.
# Use scripts/build-club-arena.sh to rebuild — it atomically
# cleans old hashes, copies new build, and commits+pushes.
# NEVER manually add files to public/hub/club-arena/.

# Local deployment logs and temporary files
vercel_deploy_output.txt
git_status_all.txt


# Soft-deleted paths (sandboxed delete tombstones)
*.dead
**/*.dead/
*.dead.*
**/*.dead.*/
_legacy_club_arena_standalone_pages.dead/

# Virtiofs EPERM workaround: stale rename tombstones (safe to ignore; cleaned up outside git)
*.stale.*
**/*.stale.*/

# Source maps inside public/ — uploaded to Sentry at build, not shipped to browsers via git
public/hub/club-arena/assets/*.js.map
public/hub/club-arena/assets/*.css.map
